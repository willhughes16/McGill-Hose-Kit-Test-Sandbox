# Runtime output — never committed
_report/
raw/
audit_output/

# Python
__pycache__/
*.pyc

# OS noise
.DS_Store

# dist/ IS committed (git add -f dist/kit.zip) — a global gitignore may
# exclude dist/, hence the -f.

# astro-code: harness-created agent worktrees — never commit these
.claude/worktrees/

# parity fixture byproducts — regenerated on every run
tools/parity/fixtures/*/actual_*
tools/parity/fixtures/*/state.json
tools/parity/fixtures/*/case_state.json
