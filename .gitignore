# Runtime output — never committed
_report/
raw/
audit_output/

# Python
__pycache__/
*.pyc

# OS noise
.DS_Store

# dist/ IS committed (git add -f dist/kit.zip) — a global gitignore may
# exclude dist/, hence the -f.

# astro-code: harness-created agent worktrees — never commit these
.claude/worktrees/

# Fixture byproducts, ignored by INVERSION rather than by name. The previous
# version listed each byproduct (actual_*, state.json, case_state.json, reply.md,
# _report/), and adding _report/run_manifest.json in v0.16.0 walked straight past
# it: six run manifests appeared as untracked files ready to be committed into
# the fixture directories. Naming the byproducts is the wrong side to enumerate —
# a fixture directory holds INPUTS and EXPECTATIONS, everything else in it is
# regenerated. So everything is ignored and the inputs are allowed back by name:
# a new artifact is ignored for free, and a genuinely new tracked input has to be
# added with `git add -f`, which is loud.
tools/parity/fixtures/*/*
!tools/parity/fixtures/*/input.eml
!tools/parity/fixtures/*/expected_output.json

tools/golden/fixtures/*/*
!tools/golden/fixtures/*/expected_output.json
!tools/golden/fixtures/*/case_state.json
