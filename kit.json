{
  "name": "mcgill-email-to-bom",
  "version": "0.2.0",
  "description": "Read an inbound customer RFQ email and produce a deterministic CaseState plus a draft bill of materials, with every missing, ambiguous or unsafe item raised as an explicit open item. Drafts only - a human reviews and commits in the ERP.",
  "author": "ScaleUp Labs",
  "contents": [
    "CLAUDE.md",
    "EXAMPLES.md",
    "README.md",
    "generate_report.py",
    "recipes/mcgill-email-to-bom.yaml",
    "schemas/case_state.schema.json",
    "scripts/run_engine.py",
    "vendor/PROVENANCE.md",
    "vendor/config/catalog.json",
    "vendor/config/catalog_candidates.json",
    "vendor/config/citations.json",
    "vendor/config/rules.json",
    "vendor/email_to_bom/__init__.py",
    "vendor/email_to_bom/cli.py",
    "vendor/email_to_bom/core.py",
    "vendor/email_to_bom/fields.py",
    "vendor/email_to_bom/knowledge.py",
    "vendor/email_to_bom/mail.py",
    "vendor/email_to_bom/triage.py",
    "vendor/email_to_bom/validators.py"
  ],
  "download_url": "https://TODO.example/mcgill-email-to-bom/dist/kit.zip",
  "sha256": "3db7a61946f9cbca58ca5633ecb0805027f420373db0f906a18e68e3ef6b5bfb",
  "manifest_version": 4,
  "contract_version": "^1.0.0",
  "requires": {
    "tools": [],
    "runtime": [
      "python3"
    ],
    "astro": ">=0.3.0"
  },
  "outputs": {
    "format": "json",
    "artifacts": [
      {
        "path": "_report/case_state.json",
        "tags": [
          "email_attachment"
        ]
      },
      {
        "path": "_report/bom_draft.md"
      }
    ]
  }
}
